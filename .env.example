# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Encryption secret for storing supplier API keys/secrets at rest (64-char hex)
SUPPLIER_SECRETS_ENCRYPTION_KEY=replace-with-64-char-hex-encryption-key

# Bachs.io Payment Configuration (Primary Gateway - Nigerian Naira NGN)
BACHS_ENV=sandbox
BACHS_SECRET_KEY=sk_sandbox_your_bachs_secret_key
BACHS_WEBHOOK_SECRET=whsec_your_bachs_webhook_secret

# Optional Paystack Configuration (Legacy / Alternative Gateway)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email Provider Configuration (overridable in Admin -> Website & Emails)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@yourdomain.com

# Cron Secret for automated expiry reminders and fulfilment retries
CRON_SECRET=replace-with-secure-random-cron-secret
